#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick_tap_ms = <400>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <400>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL          &hm LG(LS(X)) NUMBER_1  &kp N2          &kp N3               &hm LG(LS(NUMBER_4)) NUMBER_4  &hm LG(LS(NUMBER_5)) N5  &tog 1                                                        &mo 3      &kp N6  &kp N7               &kp N8               &kp N9           &kp N0                       &kp MINUS
&kp TAB            &kp Q                   &kp W           &hm LC(LG(SPACE)) E  &hm LC(LEFT_COMMAND) R         &hm SPACE T              &none                                                         &none      &kp Y   &hm RS(RA(MINUS)) U  &kp I                &kp O            &kp P                        &kp BSLH
&hm LC(LG(Q)) ESC  &hm LEFT_CONTROL A      &hm LEFT_ALT S  &hm LEFT_COMMAND D   &lt 3 F                        &hm ENTER G              &lt 1 A   &kp A           &kp A         &kp A      &kp A      &none      &kp H   &lt 2 J              &hm RIGHT_COMMAND K  &hm RIGHT_ALT L  &hm RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT          &kp Z                   &kp X           &hm LG(C) C          &hm LG(LS(V)) V                &kp B                                              &kp HOME      &kp PG_UP                        &kp N   &kp M                &kp COMMA            &kp DOT          &kp FSLH                     &kp RSHFT
&mo 2              &kp GRAVE               &kp CAPS        &kp LEFT             &kp RIGHT                                               &kp BSPC  &kp LEFT_SHIFT  &kp END       &kp PG_DN  &kp ENTER  &kp SPACE          &kp UP               &kp DOWN             &kp LBKT         &kp RBKT                     &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &trans  &trans    &trans    &kp F10    &kp F11  &kp F12
&kp GRAVE  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans    &trans    &trans     &trans   &trans
&kp TILDE  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans    &kp UP    &trans     &trans   &trans
&trans     &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans   &trans
&trans     &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans    &trans    &trans     &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0    &bt BT_SEL 1       &bt BT_SEL 2     &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none          &kp HOME            &none        &kp END        &none  &none
&none           &none           &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_MUTE    &none         &bootloader                                            &bootloader      &kp PAGE_UP    &kp LG(LEFT_ARROW)  &kp UP       &kp RG(RIGHT)  &none  &none
&studio_unlock  &kp C_PREVIOUS  &kp C_NEXT         &kp C_STOP       &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &kp PAGE_DOWN  &kp LEFT            &kp DOWN     &kp RIGHT      &none  &none
&none           &none           &none              &none            &macro_ver    &none                             &none      &none                                    &none          &kp RC(RS(TAB))     &kp RC(TAB)  &none          &none  &none
&none           &none           &none              &none            &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                 &bl BL_INC          &bl BL_DEC   &none          &none  &none
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
